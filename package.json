{
  "name": "piii",
  "version": "1.0.6",
  "private": true,
  "type": "module",
  "description": "AI data-loss prevention — detects and masks PII before it leaves your browser.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/JaySmith502/PiiI.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "verify": "npm run typecheck && npm run test && npm run build",
    "verify:extension": "node scripts/validate-extension.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "package": "npm run build && node scripts/validate-extension.mjs && node scripts/package.mjs",
    "bundle:submission": "node scripts/bundle-submission.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.7.0",
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.17",
    "playwright": "^1.63.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "@vitejs/plugin-react": {
      "vite": "^8.0.0"
    }
  }
}
